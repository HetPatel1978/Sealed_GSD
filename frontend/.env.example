# Copy to .env.local (gitignored) to change. Only VITE_* values reach the browser: never put secrets here.

# live = use the backend (its default sim mode makes no live requests); mock = recorded read-only preview
VITE_DATA_SOURCE=live

# The backend binds to 127.0.0.1:8000 only (python -m app.run)
VITE_API_BASE=http://127.0.0.1:8000
