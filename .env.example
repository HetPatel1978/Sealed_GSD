# Copy to .env and fill in locally. Never commit .env.
# Note: the budget ceiling is NOT configured here. It is entered per job via POST /jobs.

# Fo MCP (OAuth). Default URL is https://mcp.api.wajo.ai/fo
FO_MCP_URL=
FO_OAUTH_TOKEN_PATH=

# Gmail read-only ingestion (IMAP + app password; requires 2-Step Verification)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Quote parser (Claude API); dealer discovery uses the existing Fo connection
ANTHROPIC_API_KEY=
# Optional override for the isolated, tool-free quote extractor
ANTHROPIC_QUOTE_MODEL=claude-haiku-4-5-20251001

# App
SEALED_MODE=sim
# Optional directory for dashboard checkpoints, inbox and parse cache (defaults to .sealed/api_sim or api_live)
SEALED_API_DATA_DIR=
# Local only: loopback host and exactly one localhost dashboard origin (startup fails otherwise)
SEALED_HOST=127.0.0.1
SEALED_PORT=8000
SEALED_DASHBOARD_ORIGIN=http://localhost:3000
